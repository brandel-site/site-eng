---
interface Props { sectionHeading: string; subtext: string; }
const { sectionHeading, subtext } = Astro.props;
const FORMSPREE_ID = 'mzdqbqqp';
---
<section id="contact" class="bg-[rgba(255,255,255,0.02)] py-32 w-full" aria-labelledby="contact-heading">
  <div class="max-w-site mx-auto px-16 grid grid-cols-1 md:grid-cols-2 gap-x-[80px] gap-y-16">

    <!-- Left: heading + description — constrained to 548px -->
    <div class="flex flex-col gap-8 self-start max-w-[548px]">
      <div class="bg-brand-yellow h-1 w-12" aria-hidden="true"></div>
      <div class="flex flex-col gap-4">
        <h2 id="contact-heading" class="font-merriweather font-bold text-brand-white text-h2 leading-[1.11]">
          {sectionHeading}
        </h2>
        <p class="font-merriweather-sans font-normal text-brand-gray-1 text-body leading-[1.625]">
          {subtext}
        </p>
      </div>
    </div>

    <!-- Right: form -->
    <div class="flex flex-col gap-9 self-start">
      <div id="form-success" class="hidden bg-green-900/30 border border-green-500/40 text-green-300 text-sm font-merriweather-sans px-4 py-3 rounded-lg" role="alert">
        Thank you! Your message has been sent. Michal will be in touch shortly.
      </div>
      <div id="form-error" class="hidden bg-red-900/30 border border-red-500/40 text-red-300 text-sm font-merriweather-sans px-4 py-3 rounded-lg" role="alert">
        Something went wrong. Please try again or email directly.
      </div>

      <form id="contact-form" novalidate class="flex flex-col gap-6" aria-label="Contact form">

        <div class="flex flex-col gap-2">
          <label for="company" class="font-merriweather-sans text-brand-white text-sm-label leading-5">Company Name</label>
          <input type="text" id="company" name="company" autocomplete="organization"
            class="bg-white border border-[#d4d4d4] rounded-lg h-[50px] px-4 text-[#171818] font-merriweather-sans text-body w-full focus:outline-none focus:ring-2 focus:ring-brand-yellow" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="name" class="font-merriweather-sans text-brand-white text-sm-label leading-5">
            Contact Name <span class="text-brand-yellow" aria-hidden="true">*</span>
          </label>
          <input type="text" id="name" name="name" required autocomplete="name" aria-required="true"
            class="bg-white border border-[#d4d4d4] rounded-lg h-[50px] px-4 text-[#171818] font-merriweather-sans text-body w-full focus:outline-none focus:ring-2 focus:ring-brand-yellow" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="email" class="font-merriweather-sans text-brand-white text-sm-label leading-5">
            Email Address <span class="text-brand-yellow" aria-hidden="true">*</span>
          </label>
          <input type="email" id="email" name="email" required autocomplete="email" aria-required="true"
            class="bg-white border border-[#d4d4d4] rounded-lg h-[50px] px-4 text-[#171818] font-merriweather-sans text-body w-full focus:outline-none focus:ring-2 focus:ring-brand-yellow" />
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="font-merriweather-sans text-brand-white text-sm-label leading-5">
            Message <span class="text-brand-yellow" aria-hidden="true">*</span>
          </label>
          <textarea id="message" name="message" required aria-required="true" rows="5"
            class="bg-white border border-[#d4d4d4] rounded-lg px-4 py-3 text-[#171818] font-merriweather-sans text-body w-full resize-none focus:outline-none focus:ring-2 focus:ring-brand-yellow"></textarea>
        </div>

        <div style="display:none" aria-hidden="true">
          <label>Do not fill this out: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </div>

        <p class="font-merriweather-sans text-brand-gray-3 text-xs leading-relaxed">
          Submitting this form does not create an attorney-client relationship. Please do not include confidential information.
        </p>

        <button type="submit"
          class="bg-brand-yellow text-brand-darker font-dm-sans font-semibold text-body leading-6 px-5 py-3 rounded-lg w-full text-center hover:bg-brand-yellow-light transition-colors disabled:opacity-60">
          <span id="btn-label">Contact</span>
        </button>
      </form>
    </div>

  </div>
</section>

<script define:vars={{ FORMSPREE_ID }}>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('form-success');
  const errorBox = document.getElementById('form-error');
  const btnLabel = document.getElementById('btn-label');
  const btn = form?.querySelector('button[type="submit"]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    btn?.setAttribute('disabled', 'true');
    if (btnLabel) btnLabel.textContent = 'Sending…';
    try {
      const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' },
      });
      if (res.ok) { form.reset(); success?.classList.remove('hidden'); errorBox?.classList.add('hidden'); }
      else throw new Error();
    } catch {
      errorBox?.classList.remove('hidden'); success?.classList.add('hidden');
    } finally {
      btn?.removeAttribute('disabled');
      if (btnLabel) btnLabel.textContent = 'Contact';
    }
  });
</script>
