---
interface Props { copyright: string; }
const { copyright } = Astro.props;
---
<footer class="bg-brand-dark py-6 w-full">
  <div class="max-w-site mx-auto px-16 flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="font-dm-sans text-brand-gray-3 text-sm-label leading-5 text-center">
      {copyright}
    </p>
    <nav aria-label="Footer navigation" class="flex gap-6">
      <a href="#services"  class="font-dm-sans text-brand-gray-3 text-sm-label hover:text-brand-white transition-colors">Services</a>
      <a href="#about"     class="font-dm-sans text-brand-gray-3 text-sm-label hover:text-brand-white transition-colors">About</a>
      <a href="#contact"   class="font-dm-sans text-brand-gray-3 text-sm-label hover:text-brand-white transition-colors">Contact</a>
    </nav>
  </div>
</footer>
