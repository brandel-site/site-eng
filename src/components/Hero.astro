---
interface Props {
  heading:         string;
  subtext:         string;
  ctaText:         string;
  backgroundImage: string;
}
const { heading, subtext, ctaText, backgroundImage } = Astro.props;
---
<section class="relative bg-brand-darker overflow-hidden py-32" aria-label="Hero">

  <!-- Full-bleed background image + gradient -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <img src={backgroundImage} alt="" class="absolute inset-0 w-full h-full object-cover" width="1053" height="700" loading="eager" />
    <div class="absolute inset-0" style="background:linear-gradient(-88deg,rgba(23,24,24,0) 35%,rgba(23,24,24,0.85) 43%,#171818 100%)"></div>
  </div>

  <!-- Centered content wrapper — 1120px max, 64px gutters -->
  <div class="max-w-site mx-auto px-16 relative w-full">
    <div class="flex flex-col gap-8 items-start max-w-[548px]">

      <!-- Heading with vertical accent line -->
      <div class="flex gap-5 items-start w-full">
        <div class="accent-line-v shrink-0" aria-hidden="true"></div>
        <h1 class="font-merriweather font-bold text-brand-white text-hero leading-[1.25]">
          {heading}
        </h1>
      </div>

      <p class="font-merriweather-sans font-normal text-brand-white text-body-lg leading-relaxed">
        {subtext}
      </p>

      <a href="#contact"
        class="inline-flex items-center gap-2 bg-brand-yellow text-brand-darker font-merriweather-sans font-normal text-body leading-6 px-8 py-4 rounded-xl hover:bg-brand-yellow-light transition-colors">
        {ctaText}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>

    </div>
  </div>
</section>
